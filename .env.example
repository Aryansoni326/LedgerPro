# ==========================================
# LedgerPro v2 Environment Variables
# ==========================================
# Local: copy to `.env`
# Render: use `.env.render` (import into each service) — see DEPLOYMENT.md

# --- Django ---
DEBUG=True
SECRET_KEY=django-insecure-replace-this-with-a-real-secret-key-for-prod
ALLOWED_HOSTS=localhost,127.0.0.1,backend
FRONTEND_URL=http://localhost:3001

# --- Database (local Docker) ---
DB_NAME=ledgerpro_db
DB_USER=ledgerpro_user
DB_PASSWORD=ledgerpro_secure_password
DB_HOST=db
DB_PORT=5432
# On Render, prefer DATABASE_URL from managed Postgres instead.

# --- Redis & Celery ---
REDIS_URL=redis://redis:6379/0

# --- Google OAuth ---
# Local:  http://localhost:3001/auth/google/callback
# Render: https://YOUR-FRONTEND.onrender.com/auth/google/callback
GOOGLE_OAUTH_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=your-google-oauth-client-secret
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3001/auth/google/callback

# --- AI ---
GEMINI_API_KEY=your-gemini-api-key

# --- Cloudflare R2 ---
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=ledgerpro-vault
R2_ENDPOINT_URL=https://your-account-id.r2.cloudflarestorage.com

# --- Email (Resend — preferred) ---
# 1. Create an API key at https://resend.com/api-keys
# 2. Verify your domain at https://resend.com/domains
# 3. Use a from-address on that verified domain (not @gmail.com)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
DEFAULT_FROM_EMAIL=LedgerPro <noreply@your-verified-domain.com>
# Optional: allow printing OTP to backend logs when Resend is unset (local only)
OTP_CONSOLE_FALLBACK=False

# --- Email (SMTP fallback; leave blank when using Resend) ---
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=your-email@gmail.com
# EMAIL_HOST_PASSWORD=your-gmail-app-password
# EMAIL_USE_TLS=True

# --- Frontend ---
# Docker Compose maps API to host port 8001 (see docker-compose.yml)
NEXT_PUBLIC_API_URL=http://localhost:8001
